# Copia questo file in .env e inserisci i tuoi valori: .env non entra mai nel repo.
# Le fonti senza chiave (bitview.space, Coin Metrics Community, mempool.space, exchange,
# Deribit) non hanno bisogno di niente.

# FRED / ALFRED (chiave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# SoSoValue, flussi ETF (chiave gratuita)
SOSOVALUE_API_KEY=
