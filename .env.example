# Copia questo file in .env e inserisci i tuoi valori: .env non entra mai nel repo.
# Le fonti senza chiave (bitview.space, Coin Metrics Community, mempool.space, exchange,
# Deribit) non hanno bisogno di niente.

# FRED / ALFRED (chiave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# SoSoValue, flussi ETF (chiave gratuita)
SOSOVALUE_API_KEY=

# Pianificatore (python -m bailout_lab.pianificatore): tutte facoltative.
# Cartella dei dati (default: dati/) e soglia di avviso dell'archivio in GB (default: 20)
BAILOUT_LAB_DATI=
BAILOUT_LAB_SOGLIA_ARCHIVIO_GB=
# Avvisi su Telegram: senza questi restano nel log
AVVISI_TELEGRAM_TOKEN=
AVVISI_TELEGRAM_CHAT=
AVVISI_TELEGRAM_ARGOMENTO=
